# ─── SERVIDOR ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development            # development | production

# ─── BASE DE DATOS (SQL Server) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=1433
DB_NAME=planogramas
DB_USER=sa
DB_PASSWORD=tu_password_aqui
DB_SCHEMA=dbo
DB_ENCRYPT=false                # true en Azure SQL / producción
DB_TRUST_SERVER_CERTIFICATE=true  # true en desarrollo local; false en producción

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173   # URL del frontend (Vite dev server)

# ─── AUTENTICACIÓN (Entra ID / Azure AD) ─────────────────────────────────────
# Pendiente de configurar — ver REUNION_TECNICA.md
JWT_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
JWT_AUDIENCE=api://planogramas-cemaco

# ─── CAO — CemacoAllInOne (primer salto de autenticación) ────────────────────
# POST /api/auth { user, password } → data.token (token CAO)
CAO_BASE_URL=host
CAO_USER=tu_usuario_cao
CAO_PASSWORD=tu_password_cao

# ─── CATI (catálogo y jerarquía — segundo salto) ──────────────────────────────
# POST /api/Auth/exchange { tokenCemacoAllInOne: tokenCAO } → data.accessToken
# Todas las llamadas a CATI envían AMBAS credenciales:
#   - Header Authorization: Bearer {accessToken}  (JWT — endpoints que lo requieren)
#   - Header x-api-key: {CATI_API_KEY}            (API key — endpoints que lo requieren)
CATI_BASE_URL=host
CATI_API_KEY=tu_api_key_cati
