              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 201', () => pm.response.to.have.status(201));",
                      "pm.test('Retorna planograma con estado borrador', () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body).to.have.property('id');",
                      "  pm.expect(body.estado).to.eql('borrador');",
                      "  pm.expect(body.subcategorias).to.be.an('array').with.lengthOf(2);",
                      "});"
                    ]
                  }
                }
              ],
              "response": []
            },
            {
              "name": "400 - campos requeridos faltantes/invalidos",
