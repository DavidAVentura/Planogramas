{
  "info": {
    "_postman_id": "b6f2e6a0-1e3d-4c9a-9f2b-0a8f6d3c7e11",
    "name": "planogramas",
    "description": "Casos de éxito y de error para los 5 endpoints del módulo Planogramas (back/src/infrastructure/http/routes/planogramas.routes.js).\n\nUsa la variable de entorno {{HOST}} como base (ej. http://localhost:3000 o el host de staging) — configúrala en el entorno de Postman antes de ejecutar, no está definida en esta colección.\n\nLas variables de colección planogramaId / planogramaIdArchivado / planogramaIdConVersionesPublicadas / planogramaIdInexistente son ids de prueba: ajústalas a ids reales de tu base de datos según el escenario (uno en estado borrador/activo, uno ya archivado, uno con versiones publicadas asignadas a tiendas, y uno que no exista).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "planogramaId", "value": "1", "type": "string", "description": "Id de un planograma existente en estado borrador o activo" },
    { "key": "planogramaIdArchivado", "value": "2", "type": "string", "description": "Id de un planograma que ya está en estado archivado" },
    { "key": "planogramaIdConVersionesPublicadas", "value": "3", "type": "string", "description": "Id de un planograma con versiones publicadas asignadas a tiendas (no archivable)" },
    { "key": "planogramaIdInexistente", "value": "999999", "type": "string", "description": "Id que no existe en la base de datos" },
    { "key": "nombreExistente", "value": "Planograma Existente", "type": "string", "description": "Nombre + departamento que ya existen juntos en la BD, para forzar 409 por duplicado" },
    { "key": "departamentoExistente", "value": "Autos", "type": "string", "description": "Departamento asociado a nombreExistente" }
  ],
