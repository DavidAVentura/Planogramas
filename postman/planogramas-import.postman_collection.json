      "name": "planogramas",
      "item": [
        {
          "name": "Listar planogramas (GET /planogramas)",
          "item": [
            {
              "name": "200 - Listar sin filtros",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{HOST}}/api/v1/planogramas",
                  "host": ["{{HOST}}"],
                  "path": ["api", "v1", "planogramas"]
                },
                "description": "Lista paginada con los valores default (page=1, pageSize=20)."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 200', () => pm.response.to.have.status(200));",
                      "pm.test('Estructura paginada', () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body).to.have.property('data').that.is.an('array');",
                      "  pm.expect(body).to.have.property('total').that.is.a('number');",
                      "  pm.expect(body.page).to.eql(1);",
                      "  pm.expect(body.pageSize).to.eql(20);",
                      "});"
                    ]
                  }
                }
              ],
              "response": []
            },
            {
              "name": "200 - Listar con filtros (departamento, estado, search, paginacion)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{HOST}}/api/v1/planogramas?departamento=Autos&estado=activo&search=rack&page=1&pageSize=10",
                  "host": ["{{HOST}}"],
                  "path": ["api", "v1", "planogramas"],
                  "query": [
                    { "key": "departamento", "value": "Autos" },
                    { "key": "estado", "value": "activo" },
                    { "key": "search", "value": "rack" },
                    { "key": "page", "value": "1" },
                    { "key": "pageSize", "value": "10" }
                  ]
                },
                "description": "Filtra por departamento, estado y texto de búsqueda con paginación explícita."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status 200', () => pm.response.to.have.status(200));",
                      "pm.test('Respeta pageSize solicitado', () => {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.pageSize).to.eql(10);",
                      "  pm.expect(body.data.length).to.be.at.most(10);",
                      "});"
                    ]
                  }
                }
              ],
              "response": []
            },
