        {
          "name": "Crear planograma (POST /planogramas)",
          "item": [
            {
              "name": "201 - Crear planograma valido",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": {
                  "raw": "{{HOST}}/api/v1/planogramas",
                  "host": ["{{HOST}}"],
                  "path": ["api", "v1", "planogramas"]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Autos - Rack Frontal A\",\n  \"departamento\": \"Autos\",\n  \"subcategorias\": [\"Aceites\", \"Filtros\"]\n}",
                  "options": { "raw": { "language": "json" } }
