                  "host": ["{{HOST}}"],
                  "path": ["api", "v1", "planogramas"]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"\",\n  \"subcategorias\": []\n}",
                  "options": { "raw": { "language": "json" } }
