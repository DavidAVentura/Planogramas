{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run lint:css)",
      "Bash(npm run preview)",
      "Bash(npm run migrate:status)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm ls *)",
      "Bash(node --test *)",
      "Bash(npx tsc -b)",
      "Bash(npx stylelint *)",
      "Bash(npx oxlint *)",
      "Bash(npx vitest run *)",
      "Bash(npx knex migrate:status)",
      "Bash(npx playwright *)",
      "Bash(curl -s http://localhost:3000/*)",
      "Bash(curl -s -m * http://localhost:3000/*)",
      "Bash(curl -s -o /dev/null -w * http://localhost:*)",
      "Bash(netstat -ano)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Skill(run)",
      "Skill(run:*)"
    ],
    "ask": [
      "Bash(npm run migrate)",
      "Bash(npm run migrate:rollback)",
      "Bash(npx knex migrate:latest *)",
      "Bash(npx knex migrate:rollback *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(src/data/realData.js)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-archivos.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-archivo.js\"",
            "timeout": 60,
            "statusMessage": "Lint del archivo editado"
          }
        ]
      }
    ]
  }
}
