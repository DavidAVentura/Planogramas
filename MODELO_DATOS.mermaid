erDiagram

    %% ─── CORE PLANOGRAMA ───────────────────────────────────────────

    Planograma {
        int         id              PK
        varchar     nombre
        varchar     departamento
        varchar     categoria
        varchar     estado              "borrador | activo | archivado"
        datetime    created_at
        varchar     created_by
    }

    PlanogramaVersion {
        int         id              PK
        int         planograma_id   FK
        varchar     tipo                "GRANDE | MEDIANA | EXPRESS"
        varchar     codigo              "ej. AUTOS TG-03"
        int         version_base_id FK  "null si es base; FK self si es especial por tienda"
        varchar     estado
        text        notas
    }

    Gondola {
        int         id                      PK
        int         planograma_version_id   FK
        varchar     nombre
        decimal     ancho_cm
        decimal     alto_cm
        decimal     profundidad_cm
        varchar     posicion_en_tienda
        int         orden
    }

    Nivel {
        int         id                          PK
        int         gondola_id                  FK
        int         orden                           "1 = nivel más bajo"
        decimal     altura_desde_piso_cm
        decimal     ancho_disponible_cm
        varchar     tipo_accesorio                  "GANCHO | BANDEJA | BARRA | CANASTA | OTRO"
        int         codigo_accesorio_id         FK  "accesorio principal del nivel"
        decimal     tamano_accesorio_pulgadas
        text        notas
    }

    Posicion {
        int         id                  PK
        int         nivel_id            FK
        int         orden_horizontal
        varchar     sku                 FK
        decimal     ancho_asignado_cm       "sincronizado con facings_horizontal"
        int         facings_horizontal      "sincronizado con ancho_asignado_cm"
        int         facings_vertical        "cantidad apilable"
        int         unidades_por_facing     "profundidad del accesorio / profundidad del producto"
        int         capacidad_maxima        "calculado: facings_h x facings_v x unidades_por_facing"
        int         min_estetico            "calculado: si cap>=4 => facings*3+1, sino => cap*facings"
        int         min_final               "ajustable manualmente"
        int         max_final               "ajustable manualmente"
        varchar     perfil_redondeo         "MRP | ZSRE"
        varchar     modo                    "PLANOGRAMA | CROSS"
        bit         cross_externo           "true = accesorio colgante fuera de la gondola"
        bit         montar_en_display       "true = el producto trae display propio (ej. Kinder)"
        varchar     decision                "ACTIVO | INACTIVO"
        text        observaciones
    }

    PosicionAccesorio {
        int         id              PK
        int         posicion_id     FK
        int         orden
        int         accesorio_id    FK
        varchar     nota_libre          "ej. 'a la derecha', 'colocar frontal'"
    }

    HistorialSustitucion {
        int         id                      PK
        int         planograma_version_id   FK
        varchar     sku_original
        varchar     sku_sustituto
        text        motivo
        datetime    fecha
        varchar     usuario_id
        nvarchar    posiciones_afectadas    "JSON: lista de posicion_ids afectadas"
    }

    %% ─── CATÁLOGOS ─────────────────────────────────────────────────

    Producto {
        varchar     sku                     PK
        varchar     nombre
        varchar     marca
        varchar     categoria_nivel1
        varchar     categoria_nivel2
        varchar     categoria_nivel3
        varchar     subcategoria
        decimal     ancho_cm
        decimal     alto_cm
        decimal     profundidad_cm
        varchar     fuente_dimensiones          "STIBO | VTEX | MANUAL"
        bit         dimensiones_validadas
        varchar     gtin
        decimal     precio
        varchar     imagen_url
        int         unidades_por_empaque
        varchar     estado
        varchar     sku_sustituto           FK  "FK self — sustituto recomendado en catálogo"
    }

    Accesorio {
        int         id          PK
        varchar     codigo          "unique — ej. VDA-12R-PTH"
        varchar     nombre
        varchar     tipo            "GANCHO | BANDEJA | BARRA | CANASTA | OTRO"
        decimal     longitud_cm
        decimal     ancho_cm
        text        notas_capacidad
    }

    Tienda {
        int         id      PK
        varchar     codigo      "T0PC, T007, T010..."
        varchar     nombre
        varchar     tipo        "GRANDE | MEDIANA | EXPRESS"
    }

    VersionTienda {
        int         planograma_version_id    FK
        int         tienda_id               FK
    }

    %% ─── FLUJO CAPTURA (MVP foto → planograma) ─────────────────────

    SesionCaptura {
        int         id          PK
        int         tienda_id   FK
        int         gondola_id  FK  "nullable al inicio"
        varchar     estado          "iniciada | fotos_ok | propuesta | aceptada"
        datetime    created_at
        varchar     created_by
    }

    FotoCaptura {
        int         id              PK
        int         sesion_id       FK
        varchar     modulo              "izquierdo | derecho | frontal"
        varchar     url_foto
        int         calidad_resolucion
        int         calidad_luz
        int         calidad_contraste
        bit         estructura_ok
        bit         valida
        text        motivo_rechazo
    }

    DeteccionPropuesta {
        int         id              PK
        int         sesion_id       FK
        int         nivel_orden
        int         posicion_orden
        varchar     sku_candidato
        decimal     confianza
        nvarchar    alternativas    "JSON: [{sku, confianza, motivo}]"
        varchar     estado          "PENDIENTE | ACEPTADO | RECHAZADO | EDITADO"
    }

    %% ─── RELACIONES ─────────────────────────────────────────────────

    Planograma           ||--o{ PlanogramaVersion    : "tiene versiones"
    PlanogramaVersion    ||--o{ Gondola               : "contiene"
    PlanogramaVersion    ||--o{ HistorialSustitucion  : "registra sustituciones"
    PlanogramaVersion    }o--o{ Tienda                : "aplica a (via VersionTienda)"
    PlanogramaVersion    ||--o| PlanogramaVersion     : "version_base_id (especial)"

    Gondola              ||--o{ Nivel                 : "tiene niveles"
    Nivel                ||--o{ Posicion              : "tiene posiciones"
    Nivel                }o--o| Accesorio             : "accesorio principal"

    Posicion             ||--o{ PosicionAccesorio     : "usa accesorios"
    Posicion             }o--|| Producto              : "asigna SKU"

    PosicionAccesorio    }o--|| Accesorio             : "referencia"

    Producto             }o--o| Producto              : "sku_sustituto (self)"

    SesionCaptura        }o--|| Tienda                : "en tienda"
    SesionCaptura        }o--o| Gondola               : "sobre gondola"
    SesionCaptura        ||--o{ FotoCaptura           : "tiene fotos"
    SesionCaptura        ||--o{ DeteccionPropuesta    : "genera propuesta"
    DeteccionPropuesta   }o--o| Producto              : "candidato"
