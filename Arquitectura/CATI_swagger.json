{"openapi": "3.0.1","info": {"title": "API.Catalogo API REST","version": "v1"},"paths": {"/api/Assets/content": {"get": {"tags": ["Assets"],"parameters": [{"name": "assetId","in": "query","schema": {"type": "string"}},{"name": "configId","in": "query","schema": {"type": "string"}}],"responses": {"200": {"description": "Success"}}}},"/api/Auth/exchange": {"post": {"tags": ["Auth"],"requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExchangeRequest"}},"text/json": {"schema": {"$ref": "#/components/schemas/ExchangeRequest"}},"application/*+json": {"schema": {"$ref": "#/components/schemas/ExchangeRequest"}}}},"responses": {"200": {"description": "Success"}}}},"/api/Auth/refresh": {"post": {"tags": ["Auth"],"requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/RefreshRequest"}},"text/json": {"schema": {"$ref": "#/components/schemas/RefreshRequest"}},"application/*+json": {"schema": {"$ref": "#/components/schemas/RefreshRequest"}}}},"responses": {"200": {"description": "Success"}}}},"/api/Auth/logout": {"post": {"tags": ["Auth"],"requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/LogoutRequest"}},"text/json": {"schema": {"$ref": "#/components/schemas/LogoutRequest"}},"application/*+json": {"schema": {"$ref": "#/components/schemas/LogoutRequest"}}}},"responses": {"200": {"description": "Success"}}}},"/api/v1/quality/catalog-health": {"get": {"tags": ["CatalogHealth"],"summary": "Obtiene métricas de salud del catálogo de productos del último snapshot disponible.","parameters": [{"name": "hasAllMandatoryAttributes","in": "query","description": "Filtra por atributos obligatorios completos.","schema": {"type": "boolean"}},{"name": "hasRomanticDescription","in": "query","description": "Filtra por descripción romántica.","schema": {"type": "boolean"}},{"name": "hasPrimaryImage","in": "query","description": "Filtra por imagen principal.","schema": {"type": "boolean"}},{"name": "detailImagenCount","in": "query","description": "Filtra SKUs con cantidad de imágenes de detalle mayor al valor indicado. Si se omite, no se aplica filtro.","schema": {"type": "integer","format": "int32"}},{"name": "isVisibleInCemaco","in": "query","description": "Filtra por visibilidad en Cemaco.","schema": {"type": "boolean"}},{"name": "isOnWorkflow","in": "query","description": "Filtra por artículos en flujo comercial.","schema": {"type": "boolean"}}],"responses": {"200": {"description": "Métricas de salud del catálogo","content": {"text/plain": {"schema": {"$ref": "#/components/schemas/CatalogHealthResponse"}},"application/json": {"schema": {"$ref": "#/components/schemas/CatalogHealthResponse"}},"text/json": {"schema": {"$ref": "#/components/schemas/CatalogHealthResponse"}}}},"500": {"description": "Error interno del servidor","content": {"text/plain": {"schema": {"$ref": "#/components/schemas/Error"}},"application/json": {"schema": {"$ref": "#/components/schemas/Error"}},"text/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}},"/api/v1/quality/catalog-health/skus": {"get": {"tags": ["CatalogHealth"],"summary": "Obtiene el listado de SKUs con su estado de salud según los filtros indicados, del último snapshot disponible.","parameters": [{"name": "hasAllMandatoryAttributes","in": "query","description": "Filtra por atributos obligatorios completos.","schema": {"type": "boolean"}},{"name": "hasRomanticDescription","in": "query","description": "Filtra por descripción romántica.","schema": {"type": "boolean"}},{"name": "hasPrimaryImage","in": "query","description": "Filtra por imagen principal.","schema": {"type": "boolean"}},{"name": "detailImagenCount","in": "query","description": "Filtra SKUs con cantidad de imágenes de detalle mayor al valor indicado. Si se omite, no se aplica filtro.","schema": {"type": "integer","format": "int32"}},{"name": "isVisibleInCemaco","in": "query","description": "Filtra por visibilidad en Cemaco.","schema": {"type": "boolean"}},{"name": "isOnWorkflow","in": "query","description": "Filtra por artículos en flujo comercial.","schema": {"type": "boolean"}}],"responses": {"200": {"description": "Listado de SKUs con su estado de salud","content": {"text/plain": {"schema": {"$ref": "#/components/schemas/CatalogHealthSkusResponse"}},"application/json": {"schema": {"$ref": "#/components/schemas/CatalogHealthSkusResponse"}},"text/json": {"schema": {"$ref": "#/components/schemas/CatalogHealthSkusResponse"}}}},"500": {"description": "Error interno del servidor","content": {"text/plain": {"schema": {"$ref": "#/components/schemas/Error"}},"application/json": {"schema": {"$ref": "#/components/schemas/Error"}},"text/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}},"/api/Catalogo/subcategory": {"post": {"tags": ["Catalogo"],"summary": "[API Key] Obtiene información de una subcategoría por código (MATKL) o por nombre.","requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubcategoryRequest"}}}},"responses": {"200": {"description": "Información de la subcategoría encontrada.","content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubcategoryResponse"}}}},"400": {"description": "Body inválido o sin criterios de búsqueda."},"401": {"description": "No autenticado."},"403": {"description": "No autorizado."},"404": {"description": "La subcategoría consultada no existe."},"500": {"description": "Error interno en el servidor."}}}},"/api/Catalogo/upc-validation": {"post": {"tags": ["Catalogo"],"summary": "[API Key] Valida la existencia de un listado de UPCs y devuelve información de producto asociada.","requestBody": {"content": {"application/json": {"schema": {"type": "array","items": {"type": "string"}}}}},"responses": {"200": {"description": "Listado con el resultado de validación por cada UPC solicitado.","content": {"application/json": {"schema": {"type": "array","items": {"$ref": "#/components/schemas/UpcValidationDtoResponse"}}}}},"400": {"description": "Body inválido."},"401": {"description": "No autenticado."},"403": {"description": "No autorizado."},"500": {"description": "Error interno en el servidor."}}}},"/api/Catalogo/brand": {"post": {"tags": ["Catalogo"],"requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/BrandRequest"}}}},"responses": {"200": {"description": "Success"}}}},"/api/Catalogo/supplier": {"post": {"tags": ["Catalogo"],"requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/SupplierRequest"}}}},"responses": {"200": {"description": "Success"}}}},"/api/Catalogo/purchaising-group": {"post": {"tags": ["Catalogo"],"requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/PurchaisingGroupRequest"}}}},"responses": {"200": {"description": "Success"}}}},"/api/products/batch": {"post": {"tags": ["Catalogo"],"summary": "[API Key] Alta de productos nuevos por lote (CataloGO -> STEP).","requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateProductsBatchRequest"}}}},"responses": {"200": {"description": "Todos los ítems se crearon correctamente."},"207": {"description": "Resultado mixto."},"400": {"description": "Petición mal formada."},"401": {"description": "No autenticado."},"403": {"description": "No autorizado."},"500": {"description": "Error interno en el servidor."}}}},"/api/Combo/{productId}": {"get": {"tags": ["Combo"],"summary": "[Token] Obtiene información de los combos del producto con el sku especificado.","parameters": [{"name": "productId","in": "path","required": true,"schema": {"type": "string"}}],"responses": {"200": {"description": "Información del combo."},"404": {"description": "El producto no existe o no cuenta con oferta vigente."},"500": {"description": "Server Error."}}}},"/api/Jerarquia/Area": {"get": {"tags": ["Jerarquia"],"summary": "[Token] Obtiene un listado de todas las Areas de la Jerarquía Comercial de Cemaco.","description": "Operación para obtener un listado de las áreas de la jerarquía comercial de cemaco.","responses": {"200": {"description": "Listado de todas las Áreas","content": {"application/json": {"schema": {"type": "array","items": {"$ref": "#/components/schemas/Jerarquia"}}}}}}}},"/api/Jerarquia/Departamento": {"get": {"tags": ["Jerarquia"],"summary": "[Token] Obtiene un listado de todos los departamentos de la Jerarquía Comercial de Cemaco.","description": "Requiere el Id del Área obtenido en GET /Jerarquia/Area","parameters": [{"name": "area","in": "query","description": "ID del Area.","schema": {"type": "string"}},{"name": "profile","in": "query","description": "Perfil de busqueda CEMACO/GORILA","schema": {"type": "string","default": "CEMACO"}}],"responses": {"200": {"description": "Listado de departamentos","content": {"application/json": {"schema": {"type": "array","items": {"$ref": "#/components/schemas/Jerarquia"}}}}},"400": {"description": "Bad Request."},"404": {"description": "Not Found."}}}},"/api/Jerarquia/Familia": {"get": {"tags": ["Jerarquia"],"summary": "[Token] Obtiene un listado de todos las familias de la Jerarquía Comercial de Cemaco.","description": "Requiere el Id del Departamento obtenido en GET /api/Jerarquia/Departamento","parameters": [{"name": "departamento","in": "query","description": "ID del departamento.","required": true,"schema": {"type": "string"}},{"name": "profile","in": "query","description": "Perfil de busqueda CEMACO/GORILA","schema": {"type": "string","default": "CEMACO"}}],"responses": {"200": {"description": "Listado de familias","content": {"application/json": {"schema": {"type": "array","items": {"$ref": "#/components/schemas/Jerarquia"}}}}},"400": {"description": "Bad Request."},"404": {"description": "Not Found."}}}},"/api/Jerarquia/Categoria": {"get": {"tags": ["Jerarquia"],"summary": "[Token] Obtiene un listado de todas las Categorias de la Jerarquía Comercial de Cemaco.","description": "Requiere el Id de la Familia obtenido en GET /api/Jerarquia/Familia","parameters": [{"name": "familia","in": "query","description": "ID de la familia.","schema": {"type": "string"}},{"name": "profile","in": "query","description": "Perfil de busqueda CEMACO/GORILA","schema": {"type": "string","default": "CEMACO"}}],"responses": {"200": {"description": "Listado de categorías","content": {"application/json": {"schema": {"type": "array","items": {"$ref": "#/components/schemas/Jerarquia"}}}}},"400": {"description": "Bad Request."},"404": {"description": "Not Found."}}}},"/api/Jerarquia/Subcategoria": {"get": {"tags": ["Jerarquia"],"summary": "[Token] Obtiene un listado de todas las Subcategorias de la Jerarquía Comercial de Cemaco.","description": "Requiere el Id de la Categoría obtenida en GET /api/Jerarquia/Categoria","parameters": [{"name": "categoria","in": "query","description": "ID de la Categoria.","schema": {"type": "string"}},{"name": "profile","in": "query","description": "Perfil de busqueda CEMACO/GORILA","schema": {"type": "string","default": "CEMACO"}}],"responses": {"200": {"description": "Listado de subcategorías","content": {"application/json": {"schema": {"type": "array","items": {"$ref": "#/components/schemas/Jerarquia"}}}}},"400": {"description": "Bad Request."},"404": {"description": "Not Found."}}}},"/api/Jerarquia": {"get": {"tags": ["Jerarquia"],"summary": "[Token] Obtiene jerarquía completa a partir de una subcategoría.","parameters": [{"name": "subcategoria","in": "query","description": "ID de la subcategoria.","schema": {"type": "string"}}],"responses": {"200": {"description": "Jerarquía del Producto de SAP","content": {"application/json": {"schema": {"type": "array","items": {"$ref": "#/components/schemas/Jerarquia"}}}}},"400": {"description": "Bad Request."},"404": {"description": "Not Found."}}}},"/api/ListaTienda": {"get": {"tags": ["ListaTienda"],"responses": {"200": {"description": "Success"}}}},"/api/Product/{productId}": {"get": {"tags": ["Product"],"summary": "[Token] [Api-Key] Obtiene información de los atributos e imagenes del producto especificado","description": "Retorna atributos, imagenes, información del ERP y precio. Accesible con JWT y Api-Key.","parameters": [{"name": "productId","in": "path","description": "SKU del producto.","required": true,"schema": {"type": "string"}},{"name": "profile","in": "query","description": "PERFIL","schema": {"type": "string","default": "CEMACO"}}],"responses": {"200": {"description": "Información del producto","content": {"application/json": {"schema": {"$ref": "#/components/schemas/Product"}}}},"404": {"description": "El producto no existe en STEP."},"500": {"description": "Server Error."}}}},"/api/Product/search": {"get": {"tags": ["Product"],"summary": "[Token] [Api-Key] Búsqueda de productos con múltiples filtros de jerarquía","parameters": [{"name": "Area","in": "query","schema": {"type": "string"}},{"name": "Departamento","in": "query","schema": {"type": "string"}},{"name": "Familia","in": "query","schema": {"type": "string"}},{"name": "Categoria","in": "query","schema": {"type": "string"}},{"name": "Subcategoria","in": "query","schema": {"type": "string"}},{"name": "Proveedor","in": "query","schema": {"type": "string"}},{"name": "Modelo","in": "query","schema": {"type": "string"}},{"name": "Upc","in": "query","schema": {"type": "string"}},{"name": "Sku","in": "query","schema": {"type": "string"}},{"name": "Descripcion","in": "query","schema": {"type": "string"}},{"name": "Marca","in": "query","schema": {"type": "string"}},{"name": "Profile","in": "query","schema": {"type": "string"}},{"name": "OnlyWithStock","in": "query","schema": {"type": "boolean"}},{"name": "PageNumber","in": "query","schema": {"type": "integer","format": "int32"}},{"name": "PageSize","in": "query","schema": {"type": "integer","format": "int32"}}],"responses": {"200": {"description": "Success"}}}},"/api/Stock/sap/{productId}": {"get": {"tags": ["Stock"],"summary": "[Token][Api-Key] Obtiene un listado de la cantidad de stock SAP para el producto especificado","parameters": [{"name": "productId","in": "path","description": "SKU del producto.","required": true,"schema": {"type": "string"}},{"name": "profile","in": "query","description": "Perfil del producto.","schema": {"type": "string","default": "CEMACO"}}],"responses": {"200": {"description": "Inventario SAP del SKU","content": {"application/json": {"schema": {"type": "array","items": {"$ref": "#/components/schemas/InventarioSap"}}}}},"404": {"description": "El sku no cuenta con inventario en sap."}}}},"/api/Stock/sap/bulkInventoryReport": {"post": {"tags": ["Stock"],"summary": "[Token][Api-Key] Obtiene stock SAP para múltiples SKUs.","parameters": [{"name": "profile","in": "query","schema": {"type": "string","default": "CEMACO"}}],"requestBody": {"description": "Lista de SKUs.","content": {"application/json": {"schema": {"type": "array","items": {"type": "string"}}}}},"responses": {"200": {"description": "Inventario SAP por SKU."},"400": {"description": "Lista inválida."},"404": {"description": "Sin inventario."},"500": {"description": "Error interno."}}}},"/api/Oferta/{productId}": {"get": {"tags": ["Oferta"],"summary": "[Token] [Api-Key] Obtiene información de las ofertas del producto con el sku especificado.","parameters": [{"name": "productId","in": "path","description": "SKU del producto.","required": true,"schema": {"type": "string"}}],"responses": {"200": {"description": "Información de la Oferta."},"404": {"description": "El producto no existe o no cuenta con oferta vigente."},"500": {"description": "Server Error."}}}},"assets_note": "GET /api/Assets/content?assetId={id}&configId={configId} — retorna el binario de la imagen del asset"},"components": {"schemas": {"Asset": {"type": "object","properties": {"id": {"type": "string","nullable": true},"name": {"type": "string","nullable": true},"objectType": {"type": "string","nullable": true},"destinoImagen": {"type": "string","nullable": true},"azurePath_XL": {"type": "string","nullable": true},"pixelWidth": {"type": "string","nullable": true},"pixelHeight": {"type": "string","nullable": true}},"additionalProperties": false},"Attribute": {"type": "object","properties": {"name": {"type": "string","nullable": true},"value": {"type": "string","nullable": true}},"additionalProperties": false},"BrandRequest": {"type": "object","properties": {"code": {"type": "string","nullable": true},"name": {"type": "string","nullable": true}},"additionalProperties": false},"ExchangeRequest": {"type": "object","properties": {"tokenCemacoAllInOne": {"type": "string","nullable": true}},"additionalProperties": false},"InventarioSap": {"type": "object","properties": {"sku": {"type": "string","nullable": true},"centroId": {"type": "string","nullable": true},"centro": {"type": "string","nullable": true},"stock": {"type": "string","nullable": true},"stockDaniado": {"type": "string","nullable": true},"stockBloqueado": {"type": "string","nullable": true},"stockAlterno": {"type": "string","nullable": true}},"additionalProperties": false},"Jerarquia": {"type": "object","properties": {"id": {"type": "string","nullable": true},"name": {"type": "string","nullable": true},"department": {"type": "string","nullable": true}},"additionalProperties": false},"LogoutRequest": {"type": "object","properties": {"refreshToken": {"type": "string","nullable": true}},"additionalProperties": false},"Product": {"type": "object","properties": {"id": {"type": "string","nullable": true},"name": {"type": "string","nullable": true},"timaktx": {"type": "string","nullable": true},"regularPrice": {"type": "number","format": "double"},"objectType": {"type": "string","nullable": true},"parent": {"type": "string","nullable": true},"erpInformation": {"$ref": "#/components/schemas/SapInformation"},"assets": {"type": "array","items": {"$ref": "#/components/schemas/Asset"},"nullable": true},"internalAttributes": {"type": "object","additionalProperties": {"$ref": "#/components/schemas/Attribute"},"nullable": true}},"additionalProperties": false},"ProductInfoDtoResponse": {"type": "object","properties": {"sku": {"type": "integer","format": "int64"},"description": {"type": "string","nullable": true},"brand": {"type": "string","nullable": true},"category": {"type": "string","nullable": true}},"additionalProperties": false},"PurchaisingGroupRequest": {"required": ["purchaising_group_code"],"type": "object","properties": {"purchaising_group_code": {"minLength": 1,"type": "string"}},"additionalProperties": false},"RefreshRequest": {"type": "object","properties": {"refreshToken": {"type": "string","nullable": true},"token": {"type": "string","nullable": true}},"additionalProperties": false},"SapInformation": {"type": "object","properties": {"marca": {"type": "string","nullable": true},"modelo": {"type": "string","nullable": true},"pais": {"type": "string","nullable": true},"area": {"type": "string","nullable": true},"departamento": {"type": "string","nullable": true},"familia": {"type": "string","nullable": true},"categoria": {"type": "string","nullable": true},"subCategoria": {"type": "string","nullable": true},"jerarquiaId": {"type": "string","nullable": true},"temporada": {"type": "string","nullable": true},"upcs": {"type": "string","nullable": true},"tituloERP": {"type": "string","nullable": true}},"additionalProperties": false},"SubcategoryRequest": {"type": "object","properties": {"code": {"type": "string","nullable": true},"name": {"type": "string","nullable": true}},"additionalProperties": false},"SubcategoryResponse": {"type": "object","properties": {"exists": {"type": "boolean"},"official_code": {"type": "string","nullable": true},"name": {"type": "string","nullable": true},"department": {"type": "string","nullable": true}},"additionalProperties": false},"SupplierRequest": {"required": ["supplier_code"],"type": "object","properties": {"supplier_code": {"minLength": 1,"type": "string"}},"additionalProperties": false},"UpcValidationDtoResponse": {"type": "object","properties": {"exists": {"type": "boolean"},"upc": {"type": "string","nullable": true},"product_info": {"$ref": "#/components/schemas/ProductInfoDtoResponse"}},"additionalProperties": false}},"securitySchemes": {"x-api-key": {"type": "apiKey","description": "Api key en header x-api-key","name": "x-api-key","in": "header"},"Bearer": {"type": "http","description": "JWT Authorization header. Ejemplo: Authorization: Bearer {token}","scheme": "Bearer","bearerFormat": "JWT"}}},"security": [{"Bearer": [],"x-api-key": []}]}
