erDiagram

    %% ─── CORE PLANOGRAMA ───────────────────────────────────────────

    Planograma {
        int         id              PK
        varchar     nombre
        varchar     departamento
        varchar     estado              "borrador | activo | archivado"
        datetime    created_at
        varchar     created_by
    }

    PlanogramaSubcategoria {
        int         id              PK
        int         planograma_id   FK
        varchar     subcategoria        "texto referencial — universo de SKUs a considerar"
    }
    %% referencial para el analista: indica qué subcategorías debe evaluar al diseñar el planograma
    %% no implica que todos los SKUs de esas subcategorías estarán en el planograma

    PlanogramaVersion {
        int         id              PK
        int         planograma_id   FK
        varchar     tipo                "GRANDE | MEDIANA | EXPRESS"
        varchar     codigo              "ej. AUTOS TG-03"
        int         version_base_id FK  "null si es base; FK self si es especial por tienda"
        varchar     estado              "borrador | en_desarrollo | piloto | publicado | archivado"
        text        notas
    }
    %% solo una versión por planograma+tipo puede estar en 'publicado' simultáneamente
    %% índice único filtrado: CREATE UNIQUE INDEX ON PlanogramaVersion(planograma_id, tipo) WHERE estado='publicado'

    Gondola {
        int         id                      PK
        int         planograma_version_id   FK
        varchar     nombre
        decimal     ancho_cm
        decimal     alto_cm
        decimal     profundidad_cm
        varchar     posicion_en_tienda
        int         orden
    }

    Nivel {
        int         id                          PK
        int         gondola_id                  FK
        int         orden                           "1 = nivel más bajo"
        decimal     altura_desde_piso_cm            "ingreso manual obligatorio por el analista"
        decimal     ancho_disponible_cm
        varchar     tipo_accesorio                  "GANCHO | BANDEJA | BARRA | CANASTA | OTRO"
        int         codigo_accesorio_id         FK  "accesorio principal del nivel"
        decimal     tamano_accesorio_pulgadas
        text        notas
    }

    Posicion {
        int         id                  PK
        int         nivel_id            FK
        int         orden_horizontal
        varchar     sku                 FK
        decimal     ancho_asignado_cm       "sincronizado con facings_horizontal"
        int         facings_horizontal      "sincronizado con ancho_asignado_cm"
        int         cantidad_apilable       "unidades apiladas verticalmente en la misma posición"
        int         unidades_por_facing     "profundidad accesorio / profundidad producto"
        int         capacidad_maxima        "calculado: facings_h x cantidad_apilable x unidades_por_facing"
        int         min_estetico            "calculado: si unid_x_facing>=4 => facings*3+1, sino => cap*facings"
        int         min_final               "ajustable manualmente"
        int         max_final               "ajustable manualmente"
        varchar     perfil_redondeo         "MRP | ZSRE"
        varchar     modo                    "PLANOGRAMA | CROSS"
        bit         cross_externo           "true = accesorio colgante fuera de la góndola"
        bit         montar_en_display       "true = producto trae display propio (ej. Kinder)"
        bit         desborda_gondola        "true = producto cruza límite al módulo siguiente"
        varchar     nota_desborde           "ej. 'continúa en góndola 2, nivel 3'"
        varchar     decision                "ACTIVO | INACTIVO"
        text        observaciones
    }

    PosicionAccesorio {
        int         id              PK
        int         posicion_id     FK
        int         orden
        int         accesorio_id    FK
        varchar     nota_libre          "ej. 'a la derecha', 'colocar frontal'"
    }

    HistorialSustitucion {
        int         id                      PK
        int         planograma_version_id   FK
        varchar     sku_original
        varchar     sku_sustituto
        text        motivo
        datetime    fecha
        varchar     usuario_id
        nvarchar    posiciones_afectadas    "JSON: lista de posicion_ids afectadas"
    }

    %% ─── CATÁLOGOS ─────────────────────────────────────────────────

    Producto {
        varchar     sku                     PK
        varchar     nombre
        varchar     marca
        varchar     categoria_nivel1
        varchar     categoria_nivel2
        varchar     categoria_nivel3
        varchar     subcategoria
        decimal     ancho_cm
        decimal     alto_cm
        decimal     profundidad_cm
        varchar     fuente_dimensiones          "STIBO | VTEX | MANUAL"
        bit         dimensiones_validadas
        varchar     gtin
        decimal     precio
        varchar     imagen_url
        int         unidades_por_empaque
        varchar     estado
        varchar     sku_sustituto           FK  "FK self — sustituto recomendado en catálogo"
    }

    Accesorio {
        int         id          PK
        varchar     codigo          "unique — ej. VDA-12R-PTH"
        varchar     nombre
        varchar     tipo            "GANCHO | BANDEJA | BARRA | CANASTA | OTRO"
        decimal     longitud_cm
        decimal     ancho_cm
        text        notas_capacidad
    }

    Tienda {
        int         id      PK
        varchar     codigo      "T0PC, T007, T010..."
        varchar     nombre
        varchar     tipo        "GRANDE | MEDIANA | EXPRESS"
    }

    VersionTienda {
        int         planograma_version_id    FK
        int         tienda_id               FK
    }

    %% ─── FLUJO CAPTURA (MVP foto → planograma) ─────────────────────

    SesionCaptura {
        int         id                          PK
        int         planograma_version_id       FK  "siempre requerido"
        int         gondola_id                  FK  "nullable en CREACION; requerido en AUDITORIA"
        varchar     tipo_flujo                      "CREACION | AUDITORIA"
        varchar     filtro_jerarquia_nivel          "nivel1 | nivel2 | nivel3 | subcategoria"
        varchar     filtro_jerarquia_valor          "ej. 'Autos Y Motos' o 'Ceras Y Pulidores'"
        varchar     estado                          "iniciada | fotos_ok | niveles_confirmados | propuesta_lista | aceptada"
        datetime    created_at
        varchar     created_by
    }
    %% filtro_jerarquia_nivel y filtro_jerarquia_valor acotan el catálogo que el agente
    %% usa para comparar contra la foto — el analista lo selecciona al iniciar la sesión

    FotoCaptura {
        int         id          PK
        int         sesion_id   FK
        varchar     modulo          "izquierdo | derecho | frontal"
        varchar     url_foto
        int         calidad_resolucion
        int         calidad_luz
        int         calidad_contraste
        bit         estructura_ok
        bit         valida
        text        motivo_rechazo
    }

    DeteccionPropuesta {
        int         id              PK
        int         sesion_id       FK
        int         nivel_orden
        int         posicion_orden
        varchar     sku_candidato
        decimal     confianza
        nvarchar    alternativas    "JSON: [{sku, confianza, motivo}]"
        varchar     estado          "PENDIENTE | ACEPTADO | RECHAZADO | EDITADO"
    }

    %% ─── RELACIONES ─────────────────────────────────────────────────

    Planograma           ||--o{ PlanogramaVersion    : "tiene versiones"
    Planograma           ||--o{ PlanogramaSubcategoria : "subcategorías de referencia"
    PlanogramaVersion    ||--o{ Gondola               : "contiene góndolas"
    PlanogramaVersion    ||--o{ HistorialSustitucion  : "registra sustituciones"
    PlanogramaVersion    ||--o{ VersionTienda          : "asignada a tiendas"
    VersionTienda        }o--||  Tienda               : "tienda asignada"
    PlanogramaVersion    ||--o| PlanogramaVersion     : "version_base_id (especial por tienda)"

    Gondola              ||--o{ Nivel                 : "tiene niveles"
    Nivel                ||--o{ Posicion              : "tiene posiciones"
    Nivel                }o--o| Accesorio             : "accesorio principal del nivel"

    Posicion             ||--o{ PosicionAccesorio     : "usa accesorios"
    Posicion             }o--|| Producto              : "asigna SKU"
    PosicionAccesorio    }o--|| Accesorio             : "referencia accesorio"

    Producto             }o--o| Producto              : "sku_sustituto (self)"

    SesionCaptura        }o--|| PlanogramaVersion     : "sobre versión"
    SesionCaptura        }o--o| Gondola               : "góndola específica (auditoría)"
    SesionCaptura        ||--o{ FotoCaptura           : "tiene fotos"
    SesionCaptura        ||--o{ DeteccionPropuesta    : "genera propuesta"
    DeteccionPropuesta   }o--o| Producto              : "sku candidato"
